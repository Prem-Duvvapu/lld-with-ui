  {
    "title": "Revise through the owner",
    "explanation": "Draft changes intro to Hello Java. saved.get(0) observes that same page. Composition restricts ownership; it does not forbid outside observers holding references to the part.",
    "items": [
      {
        "label": "intro",
        "typeLabel": "Page",
        "fields": [
          {
            "name": "text",
            "value": "Hello Java"
          }
        ]
      },
      {
        "label": "saved intro",
        "typeLabel": "Page reference",
        "fields": [
          {
            "name": "samePage",
            "value": true
          },
          {
            "name": "text",
            "value": "Hello Java"
          }
        ]
      }
    ]
  },
  {
    "title": "Remove and retire a page",
    "explanation": "Our domain chooses removal-as-deletion: appendix is retired and its content cleared before its membership is removed. read now throws through an existing reference. UML also permits other models to detach parts before deleting a whole; that transfer policy is not implemented here.",
    "items": [
      {
        "label": "draft",
        "typeLabel": "Document",
        "fields": [
          {
            "name": "count",
            "value": 1
          }
        ]
      },
      {
        "label": "appendix",
        "typeLabel": "retired Page",
        "fields": [
          {
            "name": "owner",
            "value": "Draft"
          },
          {
            "name": "deleted",
            "value": true
          }
        ]
      },
      {
        "label": "read result",
        "typeLabel": "rejected content access",
        "fields": [
          {
            "name": "outcome",
            "value": "IllegalStateException"
          },
          {
            "name": "message",
            "value": "Page is deleted"
          }
        ]
      }
    ]
  },
  {
